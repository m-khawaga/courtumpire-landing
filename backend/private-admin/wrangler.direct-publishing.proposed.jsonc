{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "courtumpire-private-admin",
  "account_id": "a5646237c003a20af52d12c61b4bd0b7",
  "main": "entry.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 250 },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DRAFTS",
      "database_name": "courtumpire-private-drafts",
      "database_id": "ae856293-8b0e-4a42-89dd-5d148bebd329",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://admin.courtumpire.com",
    "ACCESS_ISSUER": "https://courtumpire.cloudflareaccess.com",
    "ACCESS_AUD": "fd274c26e10f8c09e63e1663cd5cde399bbf34a115d79cb1fe2ee7cb2daca772",
    "OWNER_EMAILS": "info@wynctec.com",
    "REQUIRE_ACCESS_MFA": "true",
    "ACCESS_MFA_MODE": "access-independent",
    "ACCESS_ACCOUNT_ID": "a5646237c003a20af52d12c61b4bd0b7",
    "ACCESS_APP_ID": "deb22f55-bb33-4c02-86e7-7f4fa3f59417",
    "ACCESS_POLICY_ID": "f4229622-9b79-41a7-92ae-d9b18b1433ba",
    "ACCESS_GOOGLE_IDP_ID": "5209691f-d9e3-41e1-b4ad-f5887ae9e0ae",
    "DIRECT_PUBLISHING": "true"
  },
  "services": [
    {
      "binding": "WEEKLY",
      "service": "courtumpire-weekly"
    }
  ],
  "routes": [
    {
      "pattern": "admin.courtumpire.com",
      "custom_domain": true
    }
  ]
}
